{
  "name": "wowkeyb-be",
  "version": "1.16.1",
  "description": "Wowkeyb backend",
  "type": "module",
  "main": "app.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --env-file .env.development src/app",
    "staging": "node --env-file .env.staging src/app",
    "production": "node --env-file .env.production src/app",
    "start": "node src/app",
    "update-is-public:dev": "node --env-file .env.development src/scripts/updateIsPublic.js",
    "update-is-public:staging": "node --env-file .env.staging src/scripts/updateIsPublic.js",
    "update-is-public:prod": "node --env-file .env.production src/scripts/updateIsPublic.js",
    "migrate-soft-delete:dev": "node --env-file .env.development src/scripts/migrateSoftDelete.js",
    "migrate-soft-delete:staging": "node --env-file .env.staging src/scripts/migrateSoftDelete.js",
    "migrate-soft-delete:prod": "node --env-file .env.production src/scripts/migrateSoftDelete.js",
    "seed-versions:dev": "node --env-file .env.development src/scripts/seeds/versions/seedVersions.js",
    "seed-versions:staging": "node --env-file .env.staging src/scripts/seeds/versions/seedVersions.js",
    "seed-versions:prod": "node --env-file .env.production src/scripts/seeds/versions/seedVersions.js",
    "migrate-keybindings-versions:dev": "node --env-file .env.development src/scripts/migrateKeybindingsToVersions.js",
    "migrate-keybindings-versions:staging": "node --env-file .env.staging src/scripts/migrateKeybindingsToVersions.js",
    "migrate-keybindings-versions:prod": "node --env-file .env.production src/scripts/migrateKeybindingsToVersions.js",
    "create-version-117:dev": "node --env-file .env.development src/scripts/createVersion117.js",
    "create-version-117:staging": "node --env-file .env.staging src/scripts/createVersion117.js",
    "create-version-117:prod": "node --env-file .env.production src/scripts/createVersion117.js",
    "seed-paladin-abilities:dev": "node --env-file .env.development src/scripts/seeds/abilities/seedPaladinAbilities.js",
    "seed-paladin-abilities:staging": "node --env-file .env.staging src/scripts/seeds/abilities/seedPaladinAbilities.js",
    "seed-paladin-abilities:prod": "node --env-file .env.production src/scripts/seeds/abilities/seedPaladinAbilities.js",
    "seed-warrior-abilities:dev": "node --env-file .env.development src/scripts/seeds/abilities/seedWarriorAbilities.js",
    "seed-warrior-abilities:staging": "node --env-file .env.staging src/scripts/seeds/abilities/seedWarriorAbilities.js",
    "seed-warrior-abilities:prod": "node --env-file .env.production src/scripts/seeds/abilities/seedWarriorAbilities.js",
    "seed-priest-abilities:dev": "node --env-file .env.development src/scripts/seeds/abilities/seedPriestAbilities.js",
    "seed-priest-abilities:staging": "node --env-file .env.staging src/scripts/seeds/abilities/seedPriestAbilities.js",
    "seed-priest-abilities:prod": "node --env-file .env.production src/scripts/seeds/abilities/seedPriestAbilities.js",
    "seed-all-abilities:dev": "npm run seed-paladin-abilities:dev && npm run seed-warrior-abilities:dev && npm run seed-priest-abilities:dev",
    "seed-all-abilities:staging": "npm run seed-paladin-abilities:staging && npm run seed-warrior-abilities:staging && npm run seed-priest-abilities:staging",
    "seed-all-abilities:prod": "npm run seed-paladin-abilities:prod && npm run seed-warrior-abilities:prod && npm run seed-priest-abilities:prod"
  },
  "author": "Logan Born",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-ses": "^3.806.0",
    "aws-sdk": "^2.1692.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.1.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.23.3",
    "@babel/plugin-syntax-import-assertions": "^7.23.3",
    "eslint": "^8.56.0"
  },
  "volta": {
    "node": "22.15.0"
  }
}
